# QuickDraw Environment Configuration
# Copy this file to .env and customize the values for your environment

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

# Application Environment
NODE_ENV=development

# ==========================================
# NETWORK & PORTS CONFIGURATION
# ==========================================

# Port Configuration
FRONTEND_PORT=3000
BACKEND_PORT=8000
DASHBOARD_PORT=8501
REDIS_PORT=6379

# Host Configuration
FRONTEND_HOST=localhost
BACKEND_HOST=localhost
DASHBOARD_HOST=localhost
REDIS_HOST=localhost

# Client URLs (used for CORS and frontend references)
FRONTEND_CLIENT=http://localhost:3000
BACKEND_CLIENT=http://localhost:8000
DASHBOARD_CLIENT=http://localhost:8501
API_CLIENT=localhost:8000

# ==========================================
# REDIS CONFIGURATION
# ==========================================

# Redis Database Configuration
REDIS_DB=0
REDIS_PASSWORD=
REDIS_USERNAME=

# Redis Connection Settings
# REDIS_TIMEOUT=5
# REDIS_RETRY_ON_TIMEOUT=true
# REDIS_MAX_CONNECTIONS=10

# ==========================================
# CORS CONFIGURATION
# ==========================================

# Enable/Disable CORS (true/false)
CORS_ENABLED=false

# CORS allowed origins (comma-separated)
# Use * for all origins (not recommended for production)
# Add your production domain here, e.g., http://yourdomain.com:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3030,http://127.0.0.1:3000,http://127.0.0.1:3030

# CORS allowed methods (comma-separated)
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# CORS allowed headers (comma-separated, or * for all)
CORS_ALLOWED_HEADERS=*

# CORS exposed headers (comma-separated)
CORS_EXPOSED_HEADERS=*

# Allow credentials in CORS requests (true/false)
CORS_ALLOW_CREDENTIALS=true

# Maximum age for CORS preflight cache (in seconds)
CORS_MAX_AGE=3600

# ==========================================
# BACKEND API CONFIGURATION
# ==========================================

# Backend URL for dashboard (internal Docker network uses service names)
QUICKDRAW_BACKEND_URL=http://localhost:8000

# ML Model Configuration
MODEL_PATH=./model/doodleNet-model.keras
CLASSES_PATH=./classes.json
IMAGE_SIZE=784
MAX_BG_SAMPLES_PER_CLASS=500

# Game Configuration
PER_ROUND=4
NUM_ROUNDS=6

# File Paths
FILE_EMB_5=./feature/background_embedding_5per_class.csv
FILE_UMAP=./feature/background_Umap.csv
FILE_UMAP_REDUCER=./feature/background_Umap_top72.joblib
NOTOSANSTC_PATH=../frontend/fonts/NotoSansTC.ttf

# ==========================================
# DASHBOARD CONFIGURATION
# ==========================================

# Dashboard Settings
AUTO_REFRESH_INTERVAL=30
MAX_PLAYERS_IN_CHARTS=20
DEFAULT_TIME_RANGE=All time
DEFAULT_DIFFICULTIES=easy,hard

# Chart Configuration
CHART_HEIGHT=400
EASY_COLOR=#4CAF50
HARD_COLOR=#F44336

# Pagination Settings
MAX_SESSIONS_PER_PAGE=100
MAX_RANKINGS_DISPLAY=100

# Cache Settings
CACHE_TTL=300

# ==========================================
# DOCKER CONFIGURATION
# ==========================================

# Docker Compose Configuration
COMPOSE_PROJECT_NAME=quickdraw

# Docker Network
DOCKER_NETWORK=quickdraw-network

# Volume Configuration
# REDIS_DATA_VOLUME=redis_data
# LOGS_VOLUME=./logs
# UPLOADS_VOLUME=./backend/uploads

# ==========================================
# SECURITY CONFIGURATION
# ==========================================

# CORS Settings
# CORS_ORIGINS=http://localhost:3000,http://localhost:8501
# CORS_ALLOW_CREDENTIALS=true

# Security Headers
# SECURE_HEADERS=true

# ==========================================
# LOGGING CONFIGURATION
# ==========================================

# Log Levels (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# BACKEND_LOG_LEVEL=INFO
# DASHBOARD_LOG_LEVEL=INFO

# Log File Configuration
# LOG_FILE_ENABLED=true
# LOG_FILE_PATH=./logs
# LOG_FILE_MAX_SIZE=10MB
# LOG_FILE_BACKUP_COUNT=5

# ==========================================
# DEVELOPMENT CONFIGURATION
# ==========================================

# Debug Mode
# DEBUG=false
# DEVELOPMENT_MODE=true

# Hot Reload
# HOT_RELOAD=true
# WATCH_FILES=true

# Performance Settings
# WORKERS=1
# THREAD_POOL_SIZE=4

# ==========================================
# PRODUCTION CONFIGURATION
# ==========================================

# Production Settings (uncomment for production)
# NODE_ENV=production
# DEBUG=false
# DEVELOPMENT_MODE=false
# HOT_RELOAD=false
# WORKERS=4
# LOG_LEVEL=WARNING

# SSL Configuration (for production)
# SSL_ENABLED=false
# SSL_CERT_PATH=
# SSL_KEY_PATH=

# ==========================================
# EXTERNAL SERVICES CONFIGURATION
# ==========================================

# External API Configuration (if needed)
# EXTERNAL_API_URL=
# EXTERNAL_API_KEY=
# EXTERNAL_API_TIMEOUT=30

# Cloud Storage (if needed)
# CLOUD_STORAGE_PROVIDER=
# CLOUD_STORAGE_BUCKET=
# CLOUD_STORAGE_REGION=

# ==========================================
# MONITORING & ANALYTICS
# ==========================================

# Health Check Configuration
# HEALTH_CHECK_ENABLED=true
# HEALTH_CHECK_INTERVAL=30

# Metrics Collection
# METRICS_ENABLED=false
# METRICS_PORT=9090

# Analytics
# ANALYTICS_ENABLED=false